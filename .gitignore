# Publication allowlist: local reference programs and working data stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.zh-CN.md
!/LICENSE
!/NOTICE
!/docs/
!/examples/
!/scripts/
!/.github/
!/python/
/python/*
!/python/pyproject.toml
!/python/README.md
!/python/LICENSE.mixcr
!/python/mixcrpy/
!/python/tests/
/python/tests/*
!/python/tests/test_*.py
!/python/tests/*.json
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
build/
dist/
results/
